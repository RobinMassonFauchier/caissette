# Identifiants OAuth 2.0 (type « Application Web ») créés dans Google Cloud Console.
# Voir le README pour la procédure pas à pas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clé de chiffrement du cookie de session (32 caractères minimum).
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# URL publique de l'application. Doit correspondre à l'URL de redirection OAuth déclarée.
# En local : http://localhost:3000
# Derrière un tunnel HTTPS : https://mon-tunnel.exemple.com
APP_URL=http://localhost:3000

# Optionnel : restreindre l'accès à certains comptes Google (séparés par des virgules).
# Laissez vide pour autoriser tout compte Google disposant du lien.
# ALLOWED_EMAILS=robin@gmail.com,conjoint@gmail.com
